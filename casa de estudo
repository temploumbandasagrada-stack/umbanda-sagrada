<script>
function mostrar(qual) {
  document.getElementById('cxLogin').style.display = qual === 'login' ? 'block' : 'none';
  document.getElementById('cxCadastro').style.display = qual === 'cadastro' ? 'block' : 'none';
}
function aviso(id, tipo, msg) {
  const el = document.getElementById(id);
  el.className = 'aviso ' + tipo; el.textContent = msg;
}

async function entrar() {
  const email = document.getElementById('loginEmail').value.trim();
  const senha = document.getElementById('loginSenha').value;
  if (!email || !senha) return aviso('avisoLogin', 'erro', 'Preencha e-mail e senha.');

  const { data, error } = await db.auth.signInWithPassword({ email, password: senha });
  if (error) return aviso('avisoLogin', 'erro', 'E-mail ou senha incorretos.');

  const { data: perfil } = await db.from('profiles').select('*').eq('id', data.user.id).single();
  if (!perfil) return aviso('avisoLogin', 'erro', 'Perfil não encontrado.');

  if (perfil.role === 'admin') { window.location.href = 'admin.html'; return; }
  if (!perfil.ativo) {
    await db.auth.signOut();
    return aviso('avisoLogin', 'erro', 'Seu acesso ainda não foi liberado pela direção da casa. Aguarde a aprovação.');
  }
  window.location.href = 'aluno.html';
}

async function cadastrar() {
  const nome = document.getElementById('cadNome').value.trim();
  const email = document.getElementById('cadEmail').value.trim();
  const senha = document.getElementById('cadSenha').value;
  if (!nome || !email || senha.length < 6) return aviso('avisoCad', 'erro', 'Preencha tudo. Senha com no mínimo 6 caracteres.');

  const { error } = await db.auth.signUp({ email, password: senha, options: { data: { nome } } });
  if (error) return aviso('avisoCad', 'erro', 'Não foi possível cadastrar: ' + error.message);
  aviso('avisoCad', 'ok', 'Solicitação enviada, axé! Assim que a direção liberar seu acesso, você poderá entrar.');
}

// Enter envia
document.getElementById('loginSenha').addEventListener('keydown', e => { if (e.key === 'Enter') entrar(); });
</script>
